# ─── Authentication (choose ONE) ───────────────────────────────
# The agent uses whichever it finds, in this priority order.
# These stay server-side (Next.js API routes) and are never exposed to the browser.

# Option A — OAuth token from a Claude Pro/Max subscription.
# Generate with:  claude setup-token
# Paste the whole token here.
CLAUDE_CODE_OAUTH_TOKEN=

# Option B — standard Anthropic API key (pay-per-token, independent quota).
# Get one at https://console.anthropic.com/settings/keys
# If set, this takes priority over the OAuth token above.
ANTHROPIC_API_KEY=

# ─── Optional ───────────────────────────────────────────────────
# Override the model (defaults to claude-opus-4-8)
# COPYWRITER_MODEL=claude-opus-4-8

# Disable live web research tools (agent will rely only on pasted content)
# DISABLE_WEB_TOOLS=1
