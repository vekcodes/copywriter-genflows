# ─── Authentication (required) ──────────────────────────────────
# Stays server-side (Next.js API routes) and is never exposed to the browser.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ─── Optional ───────────────────────────────────────────────────
# Override the model (defaults to claude-opus-4-8)
# COPYWRITER_MODEL=claude-opus-4-8

# Disable live web research tools (agent will rely only on pasted content)
# DISABLE_WEB_TOOLS=1
